<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- Ensures the page looks good on mobile devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Palindrome Checker 9000</title>
    <!-- CSS for creative elements and user experience -->
    <style>
        /* Setting up a modern, colorful background */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
        }
        /* Creating a clean "card" for the UI */
        .container {
            background-color: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            text-align: center;
            width: 350px;
        }
        /* Styling the input field for a better experience */
        input {
            padding: 10px;
            width: 80%;
            border: 2px solid #ddd;
            border-radius: 5px;
            margin-bottom: 1rem;
            font-size: 1rem;
        }
        /* Creative element: A stylish button with hover effects */
        button {
            background-color: #764ba2;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s ease;
        }
        button:hover {
            background-color: #5a368a;
        }
        /* Area for the validation and result messages */
        #resultDisplay {
            margin-top: 1.5rem;
            font-weight: bold;
            min-height: 1.2em;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Main heading -->
        <h1>Palindrome Pulse</h1>
        <p>Enter a word to test it!</p>

        <!-- Using a form as required -->
        <form id="palindromeForm">
            <!-- Input for the user string -->
            <input type="text" id="userInput" placeholder="e.g., Racecar" required>
            <br>
            <!-- Button to trigger the process -->
            <button type="submit" id="submitBtn">Check Word</button>
        </form>

        <!-- Container for innerHTML messages -->
        <div id="resultDisplay"></div>
    </div>

    <!-- External script link to keep HTML clean -->
    <script src="script.js"></script>
</body>
</html>
